# ============================================================
# WarCrafted-ControlP - Configuracion de entorno
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas el archivo .env real al repositorio.
# ============================================================

# --- Aplicacion ---
APP_NAME=WarCrafted-ControlP
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Seguridad ---
# Genera uno nuevo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Pon esto en true si sirves el panel detras de HTTPS (recomendado en produccion)
COOKIE_SECURE=false

# --- Base de datos interna del panel (usuarios/sesiones) ---
APP_DB_URL=sqlite:///./data/app.db

# --- Logs historicos de las instancias ---
# Carpeta donde se guarda un fichero por cada arranque de cada instancia
INSTANCES_LOGS_DIR=./logs/instances
# Antiguedad maxima antes de purgar un log (dias)
LOGS_RETENTION_DAYS=7
# Como maximo, cuantos arranques conservar por categoria aunque no hayan caducado
LOGS_MAX_RUNS=15

# --- Tienda de plugins y autoactualizacion del panel (GitHub) ---
# Personal Access Token (fine-grained) con permiso "Contents: Read-only"
# sobre AMBOS repos de abajo. Se puede configurar tambien desde la propia UI
# (Tienda de Plugins), que lo guarda aqui automaticamente.
GITHUB_PLUGIN_TOKEN=
GITHUB_PLUGIN_REPO=tortosi/WarCraftedCP-plugins
GITHUB_CORE_REPO=tortosi/WarCrafted-ControlP

# ============================================================
# Instancias de emulador
# Define tantas instancias como necesites con el prefijo INSTANCE_<N>_
# TYPE admite: azerothcore | playerbots
# ============================================================

INSTANCE_1_ENABLED=true
INSTANCE_1_NAME=AzerothCore-Main
INSTANCE_1_TYPE=azerothcore

# Procesos a monitorizar (nombre del binario, sin ruta)
INSTANCE_1_WORLD_PROCESS=worldserver
INSTANCE_1_AUTH_PROCESS=authserver

# Comando y directorio de trabajo para iniciar el worldserver
INSTANCE_1_START_CMD=/opt/azerothcore/bin/worldserver
INSTANCE_1_WORKDIR=/opt/azerothcore/bin

# Comando para iniciar el authserver propio de esta instancia (opcional; sin
# el sigue funcionando todo lo demas, pero el panel no podra arrancarlo/
# pararlo). Si dos o mas instancias comparten un unico authserver, ignora
# esto y usa INSTANCE_<N>_AUTH_SERVICE_ID en su lugar (ver mas abajo).
INSTANCE_1_AUTH_START_CMD=/opt/azerothcore/bin/authserver

# Acceso SOAP (comandos GM)
INSTANCE_1_SOAP_HOST=127.0.0.1
INSTANCE_1_SOAP_PORT=7878
INSTANCE_1_SOAP_USER=soapadmin
INSTANCE_1_SOAP_PASS=CHANGE_ME

# Base de datos del emulador (solo se usa para leer estadisticas)
INSTANCE_1_DB_HOST=127.0.0.1
INSTANCE_1_DB_PORT=3306
INSTANCE_1_DB_USER=acore
INSTANCE_1_DB_PASS=CHANGE_ME
INSTANCE_1_DB_CHARACTERS=acore_characters
# Nombre de la base de datos de cuentas (para las cifras de la tarjeta del authserver)
INSTANCE_1_DB_AUTH=acore_auth
# Nombre de la base de datos de mundo (item_template/spell_dbc/game_tele; solo la usan
# plugins que necesiten autocompletar objetos, hechizos o ubicaciones de teletransporte)
INSTANCE_1_DB_WORLD=acore_world
# Solo si esta instancia usa el modulo mod-playerbots (deja sin definir si no)
# INSTANCE_1_DB_PLAYERBOTS=acore_playerbots

# Logs nativos de AzerothCore para esta instancia (opcional): la carpeta
# LogsDir configurada en su worldserver.conf, y que categorias copiar al
# historico ademas de la consola (que siempre se guarda). Categorias
# admitidas: server, errors, playerbots, gm, chat. Si se deja vacio, el
# panel solo guarda la consola.
# INSTANCE_1_ACORE_LOGS_DIR=/opt/azerothcore/logs
# INSTANCE_1_LOG_CATEGORIES=server,errors

# --- Ejemplo de segunda instancia (Playerbots), descomenta y ajusta ---
# INSTANCE_2_ENABLED=true
# INSTANCE_2_NAME=Playerbots-Test
# INSTANCE_2_TYPE=playerbots
# INSTANCE_2_WORLD_PROCESS=worldserver
# INSTANCE_2_AUTH_PROCESS=authserver
# INSTANCE_2_START_CMD=/opt/azerothcore-playerbots/bin/worldserver
# INSTANCE_2_AUTH_START_CMD=/opt/azerothcore-playerbots/bin/authserver
# INSTANCE_2_WORKDIR=/opt/azerothcore-playerbots/bin
# INSTANCE_2_SOAP_HOST=127.0.0.1
# INSTANCE_2_SOAP_PORT=7879
# INSTANCE_2_SOAP_USER=soapadmin
# INSTANCE_2_SOAP_PASS=CHANGE_ME
# INSTANCE_2_DB_HOST=127.0.0.1
# INSTANCE_2_DB_PORT=3306
# INSTANCE_2_DB_USER=acore
# INSTANCE_2_DB_PASS=CHANGE_ME
# INSTANCE_2_DB_CHARACTERS=acore_playerbots_characters
# INSTANCE_2_DB_WORLD=acore_world_test
# INSTANCE_2_DB_AUTH=acore_auth
# INSTANCE_2_ACORE_LOGS_DIR=/opt/Servers/acore-test/logs
# INSTANCE_2_LOG_CATEGORIES=chat
# Solo si esta instancia usa el modulo mod-playerbots (deja sin definir si no)
# INSTANCE_2_DB_PLAYERBOTS=acore_playerbots

# ============================================================
# Authserver compartido (opcional)
# Si dos o mas reinos comparten UN UNICO proceso authserver, en vez de que
# cada uno tenga el suyo (bloque AUTH_START_CMD/DB_AUTH de arriba), define
# aqui ese authserver una sola vez con el prefijo AUTH_SERVICE_<M>_ y haz
# que cada INSTANCE_<N>_AUTH_SERVICE_ID apunte a "auth-service-<M>". El
# dashboard le dedica entonces una unica tarjeta con todos los reinos
# vinculados, en vez de una por reino.
# ============================================================

# AUTH_SERVICE_1_NAME=Authserver compartido
# AUTH_SERVICE_1_ENABLED=true
# AUTH_SERVICE_1_PROCESS=authserver
# AUTH_SERVICE_1_START_CMD=/opt/azerothcore-auth/bin/authserver
# AUTH_SERVICE_1_WORKDIR=/opt/azerothcore-auth/bin
# AUTH_SERVICE_1_DB_HOST=127.0.0.1
# AUTH_SERVICE_1_DB_PORT=3306
# AUTH_SERVICE_1_DB_USER=acore
# AUTH_SERVICE_1_DB_PASS=CHANGE_ME
# AUTH_SERVICE_1_DB_NAME=acore_auth
#
# INSTANCE_1_AUTH_SERVICE_ID=auth-service-1
# INSTANCE_2_AUTH_SERVICE_ID=auth-service-1
